# Copy to client/.env.local for local overrides, or to client/.env.production for a production build.
# Only VITE_* values reach the browser bundle: never put a secret here.

# Absolute URL of the API including /api. Required for production builds and for the Android app
# (a same-origin "/api" would resolve to the WebView's own origin).
# When unset, `npm run dev` falls back to http://localhost:4000/api.
VITE_API_URL=http://localhost:4000/api
