# Render (and other platforms) set NODE_ENV=production for Node web
# services by default. Plain `npm install` respects that and silently
# omits devDependencies as a result — which is where TypeScript itself,
# tsx, all @types/* packages, Vite, and Tailwind live in this project.
# This forces devDependencies to install regardless of NODE_ENV, so the
# Render Build Command (`npm install && npm run build && npm run migrate`)
# gets the same dependency tree as a normal local install.
include=dev
