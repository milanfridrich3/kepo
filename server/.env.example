# Copy to server/.env for local development. Never commit the real file.
# In production (Render) set these as environment variables on the API web service instead.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/kepo
# Long random string (32+ characters). Also keys the hashes of emailed codes: changing it invalidates every session and outstanding code.
JWT_SECRET=change-this-to-a-long-random-string
# Origin the web app is served from (CORS, CSRF origin check, base of email links). Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Email (Resend). Without both, no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Kepo <no-reply@example.com>
# EMAIL_REPLY_TO=
# Private mailbox that gets a notification for each feedback message (Settings → Feedback). Server-only secret; never put it in the client or the legal pages.
# FEEDBACK_NOTIFY_EMAIL=
# APP_URL=            # defaults to CLIENT_ORIGIN
# LANDING_URL=        # defaults to https://kepo.is-cool.dev
# EMAIL_LOGO_URL=

# Local development only (ignored in production)
# EMAIL_VERIFICATION_REQUIRED=false

# Optional tuning
# PORT=4000
# VERIFICATION_CODE_TTL_MINUTES=15
# RESET_TOKEN_TTL_MINUTES=60
# EMAIL_RESEND_COOLDOWN_SECONDS=60
# REMINDERS_ENABLED=true
# REMINDERS_HOUR_UTC=6
